{
	"schemaVersion": 1,
	"id": "grademenu",
	"version": "${version}",
	"name": "Grade Menu",
	"description": "Boutons dans l'inventaire pour les commandes de grade (Confirmé·e, Premium) et un menu des homes. Commandes : /grade-set, /grade-position, /grade-bouton.",
	"authors": ["PriorDBZ"],
	"contact": {
		"sources": "https://github.com/PriorDBZ/grade-menu"
	},
	"license": "MIT",
	"icon": "assets/grademenu/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["fr.grademenu.GradeMenuClient"]
	},
	"mixins": ["grademenu.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
